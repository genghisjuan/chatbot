# Environment Variables Template
# Copy this file to .env and fill in your actual values

# OpenAI API Key (Required)
OPENAI_API_KEY=your-openai-api-key-here

# Database (PostgreSQL for Docker, SQLite for local)
DATABASE_URL=sqlite:///./analytics.db

# AWS S3 Configuration (Optional - for cloud KB storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=support-chatbot-kb

# Pinecone Vector Database (Optional - for cloud vector search)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX_NAME=support-chatbot

# Email Support via SMTP (Optional - saves to file if not configured)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@yourcompany.com
SUPPORT_EMAIL=support@yourcompany.com

# Production CORS Configuration
# For production, set this to your actual domain(s)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
